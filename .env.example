# ==============================================================================
# Google Apps Script Web App Bridge
# ==============================================================================
# URL triển khai từ Extensions > Apps Script > Deploy > New deployment (Web app)
APPSCRIPT_WEB_APP_URL=https://script.google.com/macros/s/AKfycb.../exec

# Mật mã bí mật (Phải trùng khớp với SECRET_TOKEN trong Apps Script > Project Settings > Script Properties)
APPSCRIPT_SECRET=my-secret-token-123

# ==============================================================================
# Google Drive Folder
# ==============================================================================
# ID thư mục gốc trên Google Drive (Mỗi thư mục con bên trong là 1 cuốn sách)
DRIVE_FOLDER_ID=1a2b3c4d5e6f7g8h9i0jKLMNOP

# ==============================================================================
# Google Gemini API
# ==============================================================================
# Gemini API key (Lấy miễn phí tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy...

# Model mặc định để OCR (gemini-3.6-flash, gemini-3.7-flash, gemini-3.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# ==============================================================================
# Cấu hình OCR & Chu kỳ quét
# ==============================================================================
# Bật chế độ Gemini Batch API (tiết kiệm 50% chi phí, mặc định: true)
USE_BATCH_MODE=true

# Giới hạn an toàn tốc độ OCR trực tiếp Free Tier (RPM - Requests Per Minute).
# LƯU Ý: Đây là client-side safety throttle của ứng dụng, không phải quota chính thức của Google.
# Khuyến nghị conservative: 10 RPM (~1 request / 6 giây) để tránh lỗi 429 RESOURCE_EXHAUSTED.
DIRECT_OCR_TARGET_RPM=10

# Chu kỳ tự động kiểm tra kết quả Batch Job đã gửi (phút, mặc định: 20)
BATCH_POLL_INTERVAL_MINUTES=20

# Số lượng ảnh tối đa trong 1 Batch Job (mặc định: 300)
BATCH_MAX_IMAGES_PER_JOB=300

