# Google Apps Script Web App URL (Tạo từ Extensions > Apps Script > Deploy > New deployment)
APPSCRIPT_WEB_APP_URL=https://script.google.com/macros/s/AKfycb.../exec

# Secret Token bảo mật (Tự đặt chuỗi bất kỳ, phải trùng với SECRET_TOKEN trong Apps Script Script Properties)
APPSCRIPT_SECRET=my-secret-token-123

# Google Drive folder ID chứa ảnh cần OCR (lấy từ URL folder Google Drive)
# Mỗi thư mục con bên trong sẽ được coi là 1 cuốn sách riêng biệt (bookName)
DRIVE_FOLDER_ID=1a2b3c4d5e6f7g8h9i0jKLMNOP

# Gemini API key (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy...

# Model Gemini dùng để OCR (mặc định: gemini-3.5-flash-lite, fallback: gemini-3.1-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Bật/tắt chế độ Batch (nếu false: dùng API đồng bộ realtime, nếu true: gom lô gửi Gemini Batch API giảm 50% chi phí)
USE_BATCH_MODE=true

# Đợi bao lâu sau ảnh cuối cùng upload mới submit batch (phút, mặc định: 10)
BATCH_WAIT_BEFORE_SUBMIT_MINUTES=10

# Chu kỳ kiểm tra trạng thái batch job (phút, mặc định: 20)
BATCH_POLL_INTERVAL_MINUTES=20

# Số ảnh tối đa mỗi batch job (chia nhỏ nếu 1 cuốn vượt số này, mặc định: 300)
BATCH_MAX_IMAGES_PER_JOB=300

# Chu kỳ quét thư mục tự động (phút, mặc định: 5)
POLL_INTERVAL_MINUTES=5

# Số file xử lý song song tối đa trong chế độ Direct Realtime (mặc định: 3)
MAX_CONCURRENCY=3

# Thư mục xuất file markdown (mặc định: /app/output)
OUTPUT_DIR=/app/output

# (Tùy chọn) Regex trích số thứ tự trang từ tên file (mặc định tự lấy số nguyên đầu tiên)
PAGE_ORDER_REGEX=
